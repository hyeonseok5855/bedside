rules_version = '2';

// bedside 웹/앱 공유 저장소. 개인용 1인 앱.
// 지정한 계정(이메일/비밀번호)만 읽기/쓰기. 자동 동기화로 실제 대화가 오르므로 잠근다(결정 52).
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner() {
      return request.auth != null && request.auth.token.email == "bedside@app.com";
    }
    match /sessions/{date} {
      allow read, write: if isOwner();
      match /messages/{msg} {
        allow read, write: if isOwner();
      }
    }
  }
}
