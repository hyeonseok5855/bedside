rules_version = '2';

// bedside 웹/앱 공유 저장소. 개인용 1인 앱.
// 지금은 '인증된 클라이언트만' 허용(익명 인증). 실제 민감 데이터(2단계 안드로이드
// 동기화)를 올리기 전에, 아래 TODO처럼 본인 uid로 잠가야 한다.
service cloud.firestore {
  match /databases/{database}/documents {
    match /sessions/{date} {
      allow read, write: if request.auth != null;
      // TODO(잠금): if request.auth != null && request.auth.uid == "여기에_내_uid";

      match /messages/{msg} {
        allow read, write: if request.auth != null;
        // TODO(잠금): if request.auth != null && request.auth.uid == "여기에_내_uid";
      }
    }
  }
}
